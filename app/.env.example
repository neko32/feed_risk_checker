# === TypeSafe AI（現在アクティブな判定エンジン） ===
# https://docs.typesafe.ai/api 参照。APIキーは絶対にリポジトリにコミットしないこと。
# 変数名は TYPESAFE_API_KEY ではなく API_KEY_JEV（ユーザから共有された名称）なので注意。
API_KEY_JEV=your-typesafe-ai-api-key-here

# TypeSafe AIのベースURL（通常は変更不要）。
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# TypeSafe AIのモデル名（既定: jev-latest）。
# TYPESAFE_MODEL=jev-latest

# === LM Studio（ローカルLLM "Kev"）: 現在は未使用だがコードは残っている ===
# ComplianceJudge trait のもう一つの実装（LmStudioJudge）用の設定。
# 将来TypeSafe AIからローカルKevに切り戻す場合に使う。
# LM_STUDIO_BASE_URL=http://localhost:1234
# LM_STUDIO_MODEL=Kev

# ワーカースレッド数。未指定なら論理CPUコア数を使う。
# WORKER_COUNT=8

# ジャッジ呼び出し失敗時のリトライ回数（429/529は指数バックオフで自動リトライする）。
RETRY_COUNT=3

# 永続化先のSQLiteファイルパス。
SQLITE_PATH=feed_risk.db
